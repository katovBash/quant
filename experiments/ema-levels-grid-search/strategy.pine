//@version=6
strategy("SMLT 1H · EMA 45 as support/resistance · 0.25 ATR · review", overlay = true,
     pyramiding = 0, initial_capital = 1000000, currency = currency.RUB,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, process_orders_on_close = false,
     margin_long = 100, margin_short = 100)

float level = ta.ema(close, 45)
float previousClose = nz(close[1], close)
float trueRange = math.max(high - low, math.max(math.abs(high - previousClose), math.abs(low - previousClose)))
float volatility = ta.sma(trueRange, 14)
float width = volatility * 0.25
bool valid = bar_index >= 45 and not na(volatility)
bool rawUp = valid and low >= level - width and low <= level + width and close > level
bool rawDown = valid and high >= level - width and high <= level + width and close < level
bool chartOk = syminfo.ticker == "SMLT" and timeframe.isintraday and timeframe.multiplier == 60
bool longSignal = chartOk and barstate.isconfirmed and rawUp and not rawUp[1] and not rawDown
bool shortSignal = chartOk and barstate.isconfirmed and rawDown and not rawDown[1] and not rawUp
float shares = math.floor(strategy.equity * 0.25 / close)

if longSignal and shares >= 1
    strategy.entry("Long", strategy.long, qty = shares)
else if shortSignal and shares >= 1
    strategy.entry("Short", strategy.short, qty = shares)

plot(level, "EMA 45", color = color.orange)
plot(level + width, "Upper zone", color = color.new(color.orange, 75))
plot(level - width, "Lower zone", color = color.new(color.orange, 75))
