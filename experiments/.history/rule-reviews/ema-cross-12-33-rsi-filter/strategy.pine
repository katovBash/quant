//@version=6
strategy("MOEX · EMA12/33 long + short · RSI14 filter", overlay = true,
     pyramiding = 0, initial_capital = 1000000, currency = currency.RUB,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, process_orders_on_close = false,
     margin_long = 100, margin_short = 100)

float ema12 = ta.ema(close, 12)
float ema33 = ta.ema(close, 33)
float rsi14 = ta.rsi(close, 14)
bool crossUp = barstate.isconfirmed and ta.crossover(ema12, ema33)
bool crossDown = barstate.isconfirmed and ta.crossunder(ema12, ema33)
bool allowLong = not na(rsi14) and rsi14 > 50
bool allowShort = not na(rsi14) and rsi14 < 50
float shares = math.floor(strategy.equity * 0.25 / close)

// The opposite cross exits even if RSI rejects the next entry.
if crossUp
    if allowLong and shares >= 1
        strategy.entry("Long", strategy.long, qty = shares,
             alert_message = "EMA12/33 RSI LONG {{ticker}} {{interval}}")
    else if strategy.position_size < 0
        strategy.close("Short", alert_message = "EMA12/33 RSI CLOSE SHORT {{ticker}} {{interval}}")
if crossDown
    if allowShort and shares >= 1
        strategy.entry("Short", strategy.short, qty = shares,
             alert_message = "EMA12/33 RSI SHORT {{ticker}} {{interval}}")
    else if strategy.position_size > 0
        strategy.close("Long", alert_message = "EMA12/33 RSI CLOSE LONG {{ticker}} {{interval}}")

plot(ema12, "EMA 12", color = color.aqua, linewidth = 2)
plot(ema33, "EMA 33", color = color.orange, linewidth = 2)
plot(rsi14, "RSI 14", display = display.data_window)
plotshape(crossUp and allowLong, "Long allowed", shape.triangleup, location.belowbar, color.lime)
plotshape(crossDown and allowShort, "Short allowed", shape.triangledown, location.abovebar, color.red)
