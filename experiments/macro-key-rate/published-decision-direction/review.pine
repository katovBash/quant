//@version=6
// Review only: decisions transcribed from https://www.cbr.ru/eng/dkp/mp_dec/ .
// Entry signal after the complete 14:00-15:00 hour; Python fills next 15:00 open.
// Historical Pine/Python parity and exchange execution have not been measured.
indicator("CBR key rate · published decision direction · review", overlay = true)
string mapping = input.string("conventional", "Rate mapping", options = ["conventional", "inverse", "hold_long", "hold_short"])
int holdBars = input.int(3, "Holding bars", options = [1, 3, 6])
isDay(int y, int m, int d) => year == y and month == m and dayofmonth == d
bool hike = isDay(2024, 7, 26) or isDay(2024, 9, 13) or isDay(2024, 10, 25)
bool cut = isDay(2025, 6, 6) or isDay(2025, 7, 25) or isDay(2025, 9, 12) or isDay(2025, 10, 24) or isDay(2025, 12, 19) or isDay(2026, 2, 13) or isDay(2026, 3, 20) or isDay(2026, 4, 24) or isDay(2026, 6, 19) or isDay(2026, 7, 24)
bool hold = isDay(2024, 2, 16) or isDay(2024, 3, 22) or isDay(2024, 4, 26) or isDay(2024, 6, 7) or isDay(2024, 12, 20) or isDay(2025, 2, 14) or isDay(2025, 3, 21) or isDay(2025, 4, 25) or isDay(2026, 9, 11) or isDay(2026, 10, 23)
bool fullPostHour = timeframe.isintraday and timeframe.multiplier == 60 and hour(time, "Europe/Moscow") == 14 and minute(time, "Europe/Moscow") == 0 and barstate.isconfirmed
int direction = 0
if fullPostHour
    if hike
        direction := mapping == "inverse" ? 1 : -1
    else if cut
        direction := mapping == "inverse" ? -1 : 1
    else if hold
        direction := mapping == "hold_long" ? 1 : mapping == "hold_short" ? -1 : 0
var int lastEntryBar = na
if direction != 0
    lastEntryBar := bar_index + 1
bool reviewExit = not na(lastEntryBar) and bar_index == lastEntryBar + holdBars
plotshape(direction == 1, "Review long", shape.triangleup, location.belowbar, color.lime, size = size.tiny)
plotshape(direction == -1, "Review short", shape.triangledown, location.abovebar, color.red, size = size.tiny)
plotshape(reviewExit, "Review exit", shape.xcross, location.abovebar, color.gray, size = size.tiny)
