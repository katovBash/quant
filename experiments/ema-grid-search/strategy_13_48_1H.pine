//@version=6
strategy("MOEX · EMA13/48 · PLZL VTBR GAZP · 1H · TV review", overlay = true,
     pyramiding = 0, initial_capital = 1000000, currency = currency.RUB,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, process_orders_on_close = false,
     margin_long = 100, margin_short = 100)

float fast = ta.ema(close, 13)
float slow = ta.ema(close, 48)
bool crossUp = barstate.isconfirmed and ta.crossover(fast, slow)
bool crossDown = barstate.isconfirmed and ta.crossunder(fast, slow)
float shares = math.floor(strategy.equity * 0.25 / close)

// Signals form on the closed 1H bar. TradingView fills market orders
// at the next available bar open; opposite entries reverse the position.
if crossUp and shares >= 1
    strategy.entry("Long", strategy.long, qty = shares,
         alert_message = "EMA13/48 LONG {{ticker}} {{interval}}")
else if crossDown and shares >= 1
    strategy.entry("Short", strategy.short, qty = shares,
         alert_message = "EMA13/48 SHORT {{ticker}} {{interval}}")

plot(fast, "EMA 13", color = color.aqua, linewidth = 2)
plot(slow, "EMA 48", color = color.orange, linewidth = 2)
plotshape(crossUp, "Long signal", shape.triangleup, location.belowbar, color.lime)
plotshape(crossDown, "Short signal", shape.triangledown, location.abovebar, color.red)
