//@version=6
// Fixed review rule: five bars on each side, minimum 6% reversal, next-bar orders.
// Python paper signals are checked against frozen research events. Pine order costs,
// exchange lots and short borrow differ from the Python backtest; Pine trade parity
// is not certified. Use on a 1D chart for visual review.
strategy("ZigZag confirmed breakout 5/6 · 1D · review", overlay = true,
     pyramiding = 0, initial_capital = 1000000, currency = currency.RUB,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, process_orders_on_close = false,
     margin_long = 100, margin_short = 100)
int wing = 5
float deviation = 6.0
float highPivot = ta.pivothigh(high, wing, wing)
float lowPivot = ta.pivotlow(low, wing, wing)
var int lastSide = 0
var float lastPrice = na
var float knownHigh = na
var float knownLow = na
bool chartOk = timeframe.isdaily and timeframe.multiplier == 1
bool longSignal = chartOk and barstate.isconfirmed and not na(knownHigh) and close[1] <= knownHigh and close > knownHigh
bool shortSignal = chartOk and barstate.isconfirmed and not longSignal and not na(knownLow) and close[1] >= knownLow and close < knownLow
bool exitLong = chartOk and barstate.isconfirmed and not na(knownLow) and close < knownLow
bool exitShort = chartOk and barstate.isconfirmed and not na(knownHigh) and close > knownHigh
float shares = math.floor(strategy.equity * 0.25 / close)
if longSignal and shares >= 1
    strategy.entry("Long", strategy.long, qty = shares)
else if shortSignal and shares >= 1
    strategy.entry("Short", strategy.short, qty = shares)
else if exitLong and strategy.position_size > 0
    strategy.close("Long")
else if exitShort and strategy.position_size < 0
    strategy.close("Short")
if barstate.isconfirmed
    if not na(highPivot) and (lastSide == 0 or (lastSide == 1 and highPivot > lastPrice) or (lastSide == -1 and 100 * math.abs(highPivot / lastPrice - 1) >= deviation))
        lastSide := 1
        lastPrice := highPivot
        knownHigh := highPivot
    if not na(lowPivot) and (lastSide == 0 or (lastSide == -1 and lowPivot < lastPrice) or (lastSide == 1 and 100 * math.abs(lowPivot / lastPrice - 1) >= deviation))
        lastSide := -1
        lastPrice := lowPivot
        knownLow := lowPivot
plot(knownHigh, "Confirmed resistance", color = color.new(color.red, 20), style = plot.style_stepline)
plot(knownLow, "Confirmed support", color = color.new(color.teal, 20), style = plot.style_stepline)
