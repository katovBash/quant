//@version=6
strategy("{{TITLE}} · 4H · review", overlay = true, pyramiding = 0,
    initial_capital = 1000000, currency = currency.RUB,
    commission_type = strategy.commission.percent, commission_value = 0,
    slippage = 0, process_orders_on_close = false,
    margin_long = 100, margin_short = 100)

// Historical comparison: gross, 25% position. Paper accounts use 10% and costs.
int wing = {{WING}}
float zoneAtr = {{ZONE}}
bool chartOk = timeframe.isintraday and timeframe.multiplier == 240
float ema25 = ta.ema(close, 25)
float previousClose = nz(close[1], close)
float tr = math.max(high - low, math.max(math.abs(high - previousClose), math.abs(low - previousClose)))
float atr14 = ta.sma(tr, 14)
float width = zoneAtr * atr14

// The pivot confirmed by the previous completed 4H bar becomes usable now.
float confirmedHigh = ta.pivothigh(high, wing, wing)[1]
float confirmedLow = ta.pivotlow(low, wing, wing)[1]
var float previousHigh = na
var float lastHigh = na
var int previousHighBar = na
var int lastHighBar = na
var float previousLow = na
var float lastLow = na
var int previousLowBar = na
var int lastLowBar = na
if not na(confirmedHigh)
    previousHigh := lastHigh
    previousHighBar := lastHighBar
    lastHigh := confirmedHigh
    lastHighBar := bar_index - 1 - wing
if not na(confirmedLow)
    previousLow := lastLow
    previousLowBar := lastLowBar
    lastLow := confirmedLow
    lastLowBar := bar_index - 1 - wing

float resistance = na
float support = na
if not na(previousHighBar) and bar_index - 1 - lastHighBar <= 60
    resistance := lastHigh + (lastHigh - previousHigh) * (bar_index - lastHighBar) / (lastHighBar - previousHighBar)
if not na(previousLowBar) and bar_index - 1 - lastLowBar <= 60
    support := lastLow + (lastLow - previousLow) * (bar_index - lastLowBar) / (lastLowBar - previousLowBar)

bool atSupport = not na(support) and not na(width) and width > 0 and low >= support - width and low <= support + width and close > support
bool atResistance = not na(resistance) and not na(width) and width > 0 and high >= resistance - width and high <= resistance + width and close < resistance
bool valid = chartOk and bar_index >= 33 and barstate.isconfirmed
bool longEntry = valid and atSupport and not atSupport[1] and not atResistance and ema25 > ema25[1]
bool shortEntry = valid and atResistance and not atResistance[1] and not atSupport and ema25 < ema25[1]

// Opposite first touch of EMA25 closes an existing position.
float emaWidth = 0.5 * atr14
bool rawUp = bar_index >= 25 and not na(atr14) and low >= ema25 - emaWidth and low <= ema25 + emaWidth and close > ema25
bool rawDown = bar_index >= 25 and not na(atr14) and high >= ema25 - emaWidth and high <= ema25 + emaWidth and close < ema25
bool emaUp = rawUp and not rawUp[1] and not rawDown
bool emaDown = rawDown and not rawDown[1] and not rawUp
float shares = math.floor(strategy.equity * 0.25 / close)
if longEntry and shares >= 1
    strategy.entry("Long", strategy.long, qty = shares)
else if shortEntry and shares >= 1
    strategy.entry("Short", strategy.short, qty = shares)
else if strategy.position_size > 0 and emaDown
    strategy.close("Long")
else if strategy.position_size < 0 and emaUp
    strategy.close("Short")

plot(ema25, "EMA 25", color = color.orange)
plot(support, "4H support", color = color.teal, style = plot.style_linebr)
plot(resistance, "4H resistance", color = color.red, style = plot.style_linebr)
